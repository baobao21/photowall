# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=photos

# --- Security ---
# Any long random string. Used to hash IP addresses (so a DB leak can't expose visitors).
IP_SALT=change-me-to-a-long-random-string
# Secret required by the /api/tick endpoint (for external cron jobs like cron-job.org)
CRON_SECRET=another-long-random-string

PORT=3000
